<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Vestigium.Controls.NumericUpDown">
  <Style x:Key="Vestigium.NumericUpDown.SpinnerButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.Fill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Input}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.FillHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.FillPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.FillDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:VestigiumNumericUpDown}">
    <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Control.FillInput}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text.Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Input}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:VestigiumNumericUpDown}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PART_TextBox"
                       Grid.Column="0"
                       Background="Transparent"
                       Foreground="{TemplateBinding Foreground}"
                       BorderThickness="0"
                       CaretBrush="{TemplateBinding Foreground}"
                       VerticalContentAlignment="Center"
                       TextAlignment="{TemplateBinding TextAlignment}"
                       HorizontalContentAlignment="Right"
                       Padding="8,0,6,0"
                       FontSize="13"/>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RepeatButton x:Name="PART_UpButton"
                              Grid.Row="0"
                              Style="{StaticResource Vestigium.NumericUpDown.SpinnerButton}"
                              BorderThickness="1,0,0,0">
                  <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                        Data="M 0,5 L 4,1 L 8,5 Z"
                        Stretch="Uniform"
                        Width="8" Height="5"
                        HorizontalAlignment="Center"/>
                </RepeatButton>
                <RepeatButton x:Name="PART_DownButton"
                              Grid.Row="1"
                              Style="{StaticResource Vestigium.NumericUpDown.SpinnerButton}"
                              BorderThickness="1,1,0,0">
                  <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                        Data="M 0,1 L 4,5 L 8,1 Z"
                        Stretch="Uniform"
                        Width="8" Height="5"
                        HorizontalAlignment="Center"/>
                </RepeatButton>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Focus}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Stroke.Focus}"/>
              <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Vestigium.Brushes.Status.Error}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
