<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Vestigium.Controls.NumericUpDown">
  <Style TargetType="{x:Type local:VestigiumNumericUpDown}">
    <Setter Property="Background" Value="#0F2744"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Setter Property="BorderBrush" Value="#1E3A5F"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:VestigiumNumericUpDown}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PART_TextBox"
                       Grid.Column="0"
                       Background="Transparent"
                       Foreground="{TemplateBinding Foreground}"
                       BorderThickness="0"
                       CaretBrush="{TemplateBinding Foreground}"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Right"
                       Padding="8,0,6,0"
                       FontSize="13"/>
              <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RepeatButton x:Name="PART_UpButton"
                              Grid.Row="0"
                              Focusable="False"
                              Padding="0"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1,0,0,0"
                              Background="#132744"
                              Foreground="{TemplateBinding Foreground}">
                  <Path Fill="{TemplateBinding Foreground}"
                        Data="M 0,5 L 4,1 L 8,5 Z"
                        Stretch="Uniform"
                        Width="8" Height="5"
                        HorizontalAlignment="Center"/>
                </RepeatButton>
                <RepeatButton x:Name="PART_DownButton"
                              Grid.Row="1"
                              Focusable="False"
                              Padding="0"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1,1,0,0"
                              Background="#132744"
                              Foreground="{TemplateBinding Foreground}">
                  <Path Fill="{TemplateBinding Foreground}"
                        Data="M 0,1 L 4,5 L 8,1 Z"
                        Stretch="Uniform"
                        Width="8" Height="5"
                        HorizontalAlignment="Center"/>
                </RepeatButton>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="#4A90C8"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="#4A90C8"/>
              <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="#E81123"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
