<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Vestigium.Controls.Shell"
    xmlns:vsb="clr-namespace:Vestigium.Controls.StatusBar;assembly=Vestigium.Controls.StatusBar">

  <SolidColorBrush x:Key="Vestigium.Brushes.Background" Color="#0B1524"/>
  <SolidColorBrush x:Key="Vestigium.Brushes.Chrome" Color="#0F2744"/>
  <SolidColorBrush x:Key="Vestigium.Brushes.Text" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="Vestigium.Brushes.Muted" Color="#94A3B8"/>
  <SolidColorBrush x:Key="Vestigium.Brushes.Hairline" Color="#1E3A5F"/>
  <SolidColorBrush x:Key="Vestigium.Brushes.Accent" Color="#4A90C8"/>
  <SolidColorBrush x:Key="Vestigium.Brushes.OnChrome" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="Vestigium.Brushes.OnChromeMuted" Color="#D6E8FA"/>

  <local:PositionToDockConverter x:Key="PosDock"/>
  <local:BoolToVisibilityConverter x:Key="BoolVis"/>
  <local:CountToVisibilityConverter x:Key="CountVis"/>
  <local:DepthToMarginConverter x:Key="DepthMargin"/>

  <Style x:Key="VestigiumNavRadio" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.OnChromeMuted}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" MinHeight="36" Cursor="Hand">
            <TextBlock x:Name="Label"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Text="{TemplateBinding Content}"
                       Foreground="{DynamicResource Vestigium.Brushes.OnChromeMuted}"
                       FontFamily="Segoe UI"
                       FontSize="13"/>
            <Border x:Name="Underline"
                    Height="3"
                    VerticalAlignment="Bottom"
                    Margin="10,0"
                    Background="Transparent"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Vestigium.Brushes.OnChrome}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Vestigium.Brushes.OnChrome}"/>
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Vestigium.Brushes.OnChrome}"/>
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Vestigium.Brushes.Accent}"/>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="VestigiumNavItemTemplate" DataType="{x:Type local:VestigiumNavItem}">
    <RadioButton Style="{StaticResource VestigiumNavRadio}"
                 Content="{Binding Header}"
                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                 IsEnabled="{Binding IsEnabled}"
                 Command="{Binding SelectItemCommand, RelativeSource={RelativeSource AncestorType=local:VestigiumShell}}"
                 CommandParameter="{Binding}"/>
  </DataTemplate>

  <Style TargetType="{x:Type local:VestigiumShell}">
    <Setter Property="Background" Value="{DynamicResource Vestigium.Brushes.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource Vestigium.Brushes.Text}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:VestigiumShell}">
          <Border Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}">
            <DockPanel>
              <StackPanel x:Name="PART_Nav" DockPanel.Dock="Top"
                          Background="{DynamicResource Vestigium.Brushes.Chrome}"
                          Visibility="{Binding ShowNav, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Level0Items, RelativeSource={RelativeSource TemplatedParent}}"
                              ItemTemplate="{StaticResource VestigiumNavItemTemplate}"
                              Margin="{Binding Level0Margin, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Level1Items, RelativeSource={RelativeSource TemplatedParent}}"
                              ItemTemplate="{StaticResource VestigiumNavItemTemplate}"
                              Visibility="{Binding Level1Items, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CountVis}}"
                              Margin="{Binding Level1Margin, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Level2Items, RelativeSource={RelativeSource TemplatedParent}}"
                              ItemTemplate="{StaticResource VestigiumNavItemTemplate}"
                              Visibility="{Binding Level2Items, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CountVis}}"
                              Margin="{Binding Level2Margin, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>

              <vsb:VestigiumStatusBar x:Name="PART_Status"
                                      Engine="{Binding Status.Engine, RelativeSource={RelativeSource TemplatedParent}}"
                                      Position="{Binding StatusBarPosition, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      DockPanel.Dock="{Binding StatusBarPosition, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PosDock}}"
                                      Visibility="{Binding ShowStatusBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVis}}"/>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="PART_ContentHost"
                                  Content="{Binding DisplayContent, RelativeSource={RelativeSource TemplatedParent}}"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
