<Window x:Class="Vestigium.Controls.PropertiesGrid.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pg="clr-namespace:Vestigium.Controls.PropertiesGrid;assembly=Vestigium.Controls.PropertiesGrid"
        Title="Vestigium.Controls.PropertiesGrid — gallery"
        Height="860" Width="1180"
        MinHeight="620" MinWidth="900"
        Background="#0B1524" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#0F2744" Foreground="#E2E8F0" Padding="4,2">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
    </Menu>
    <TabControl Margin="16">
      <TabItem Header="Probe">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
          </Grid.ColumnDefinitions>
          <pg:VestigiumPropertiesGrid SelectedObject="{Binding Selected, Mode=OneWay}"
                                      Sort="{Binding Sort}"
                                      IsReadOnly="{Binding IsReadOnly}"
                                      EditorTextAlignment="{Binding EditorTextAlignment}"
                                      CategoryTextAlignment="{Binding CategoryTextAlignment}"
                                      IsCategoryBold="{Binding IsCategoryBold}"
                                      CategoryOrientation="{Binding CategoryOrientation}"
                                      CategoryIcons="{Binding CategoryIcons, Mode=OneWay}"/>
          <DockPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#94A3B8" TextWrapping="Wrap"
                       Text="Live object. Edits in the grid appear here. TTL and Timeout follow EditorTextAlignment."/>
            <StackPanel DockPanel.Dock="Top">
              <Button Content="East" Command="{Binding SelectEastCommand}" Margin="0,0,0,6"/>
              <Button Content="West" Command="{Binding SelectWestCommand}" Margin="0,0,0,6"/>
              <Button Content="None" Command="{Binding SelectNoneCommand}" Margin="0,0,0,6"/>
              <Button Content="Categorized" Command="{Binding CategorizedCommand}" Margin="0,0,0,6"/>
              <Button Content="Alphabetical" Command="{Binding AlphabeticalCommand}" Margin="0,0,0,6"/>
              <CheckBox Content="Grid IsReadOnly" IsChecked="{Binding IsReadOnly}" Margin="0,8,0,8"/>
              <TextBlock Margin="0,4,0,6" Foreground="#94A3B8" Text="Editor text alignment"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Left" Command="{Binding AlignLeftCommand}" Margin="0,0,6,0" Padding="10,4"/>
                <Button Content="Center" Command="{Binding AlignCenterCommand}" Margin="0,0,6,0" Padding="10,4"/>
                <Button Content="Right" Command="{Binding AlignRightCommand}" Padding="10,4"/>
              </StackPanel>
              <TextBlock Margin="0,4,0,6" Foreground="#94A3B8" Text="Grouping headers"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Left" Command="{Binding CategoryAlignLeftCommand}" Margin="0,0,6,0" Padding="10,4"/>
                <Button Content="Center" Command="{Binding CategoryAlignCenterCommand}" Margin="0,0,6,0" Padding="10,4"/>
                <Button Content="Right" Command="{Binding CategoryAlignRightCommand}" Padding="10,4"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Horizontal" Command="{Binding CategoryHorizontalCommand}" Margin="0,0,6,0" Padding="10,4"/>
                <Button Content="Vertical" Command="{Binding CategoryVerticalCommand}" Padding="10,4"/>
              </StackPanel>
              <CheckBox Content="Bold grouping text" IsChecked="{Binding IsCategoryBold}" Margin="0,0,0,8"/>
            </StackPanel>
            <Border Background="#132744" BorderBrush="#1E3A5F" BorderThickness="1" Padding="10">
              <StackPanel>
                <TextBlock Text="{Binding Selected.DisplayName, StringFormat='Name: {0}'}"/>
                <TextBlock Text="{Binding Selected.Ttl, StringFormat='TTL: {0}'}"/>
                <TextBlock Text="{Binding Selected.Timeout, StringFormat='Timeout: {0}'}"/>
                <TextBlock Text="{Binding Selected.Enabled, StringFormat='Enabled: {0}'}"/>
                <TextBlock Text="{Binding Selected.Protocol, StringFormat='Protocol: {0}'}"/>
                <TextBlock Text="{Binding Selected.Thresholds.Warning.Latency, StringFormat='Warning latency: {0}'}"/>
                <TextBlock Text="{Binding Selected.Hops.Count, StringFormat='Hops: {0}'}"/>
                <TextBlock Margin="0,8,0,0" Foreground="#94A3B8" Text="{Binding Log}"/>
              </StackPanel>
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Multi-select">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#94A3B8" TextWrapping="Wrap"
                     Text="Two probes. Display name is mixed. One commit writes both. Collection rows will not expand."/>
          <CheckBox DockPanel.Dock="Top" Content="Select both probes" IsChecked="{Binding MultiSelect}" Margin="0,0,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>
            <pg:VestigiumPropertiesGrid SelectedObject="{Binding Selected, Mode=OneWay}"
                                        SelectedObjects="{Binding GridTargets, Mode=OneWay}"
                                        EditorTextAlignment="{Binding EditorTextAlignment}"
                                        CategoryTextAlignment="{Binding CategoryTextAlignment}"
                                        IsCategoryBold="{Binding IsCategoryBold}"
                                        CategoryOrientation="{Binding CategoryOrientation}"
                                        CategoryIcons="{Binding CategoryIcons, Mode=OneWay}"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
              <TextBlock Text="{Binding East.DisplayName, StringFormat='East: {0}'}"/>
              <TextBlock Text="{Binding West.DisplayName, StringFormat='West: {0}'}"/>
              <TextBlock Text="{Binding East.Ttl, StringFormat='East TTL: {0}'}"/>
              <TextBlock Text="{Binding West.Ttl, StringFormat='West TTL: {0}'}"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Nested form">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Margin="4" Background="#132744" BorderBrush="#1E3A5F" BorderThickness="1">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Ping"/>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Margin="4" Background="#132744" BorderBrush="#1E3A5F" BorderThickness="1">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="DNS"/>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Margin="4" Background="#132744" BorderBrush="#1E3A5F" BorderThickness="1">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Trace"/>
          </Border>
          <pg:VestigiumPropertiesGrid Grid.Row="1" Grid.Column="1" Margin="4"
                                      SelectedObject="{Binding East, Mode=OneWay}"
                                      EditorTextAlignment="{Binding EditorTextAlignment}"
                                      CategoryTextAlignment="{Binding CategoryTextAlignment}"
                                      IsCategoryBold="{Binding IsCategoryBold}"
                                      CategoryOrientation="{Binding CategoryOrientation}"
                                      CategoryIcons="{Binding CategoryIcons, Mode=OneWay}"/>
        </Grid>
      </TabItem>

      <TabItem Header="ItemsSource">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#94A3B8"
                     Text="Hand-built VestigiumPropertyItem rows. No reflection."/>
          <pg:VestigiumPropertiesGrid ItemsSource="{Binding HostItems, Mode=OneWay}"
                                      EditorTextAlignment="{Binding EditorTextAlignment}"
                                      CategoryTextAlignment="{Binding CategoryTextAlignment}"
                                      IsCategoryBold="{Binding IsCategoryBold}"
                                      CategoryOrientation="{Binding CategoryOrientation}"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
