<Application x:Class="Vestigium.Controls.StatusBar.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#0B1524"/>
    <SolidColorBrush x:Key="CardBg" Color="#132744"/>
    <SolidColorBrush x:Key="LayerBg" Color="#102038"/>
    <SolidColorBrush x:Key="Hairline" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Fg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Accent" Color="#4A90C8"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource LayerBg}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Margin" Value="0,4,12,4"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
  </Application.Resources>
</Application>
