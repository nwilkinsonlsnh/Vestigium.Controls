<Window x:Class="Vestigium.Controls.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Vestigium.Controls.Shell;assembly=Vestigium.Controls"
        Title="Vestigium.Controls — default form gallery"
        Height="860" Width="1280"
        MinHeight="640" MinWidth="980"
        Background="#0B1524" Foreground="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Vestigium.Controls;component/Shell/MenuChrome.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Button">
        <Setter Property="Background" Value="#132744"/>
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#1E3A5F"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
      </Style>
      <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#1E3A5F"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
      </Style>
      <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#F8FAFC"/>
        <Setter Property="Margin" Value="0,4,12,0"/>
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F8FAFC"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Status bar _visible" IsCheckable="True" IsChecked="{Binding ShowStatusBar}"/>
        <MenuItem Header="Status bar at _Bottom" Command="{Binding DockStatusBarBottomCommand}"/>
        <MenuItem Header="Status bar at _Top" Command="{Binding DockStatusBarTopCommand}"/>
        <Separator/>
        <MenuItem Header="Increase nav _indent" Command="{Binding IncreaseNavIndentCommand}"/>
        <MenuItem Header="Decrease nav i_ndent" Command="{Binding DecreaseNavIndentCommand}"/>
        <Separator/>
        <MenuItem Header="Stage _PingIQ suite" Command="{Binding StageIqSuiteCommand}"/>
        <MenuItem Header="Replace PingIQ with _inner form" Command="{Binding ReplacePingWithInnerFormCommand}"/>
        <MenuItem Header="_Reset Home / Workspace / Settings" Command="{Binding ResetDefaultsCommand}"/>
      </MenuItem>
    </Menu>

    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="280" MinHeight="240"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" Text="VESTIGIUM.CONTROLS"/>
        <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,2,0,6" Text="Default form gallery"/>
        <TextBlock TextWrapping="Wrap" Foreground="#94A3B8"
                   Text="File and View belong to this window only. The live form on the left is VestigiumShell — underlined radios, one construction page per slot, optional status bar. Nested shells never clone File / View."/>
      </StackPanel>

      <Border Grid.Row="1" Grid.Column="0" BorderBrush="#1E3A5F" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#0F2744" Padding="8,4">
            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#D6E8FA"
                       Text="LIVE VESTIGIUMSHELL — no File menu on this control"/>
          </Border>
          <shell:VestigiumShell x:Name="LiveShell"
                                Status="{Binding Status}"
                                StatusBarPosition="{Binding Status.Position, Mode=TwoWay}"
                                ShowStatusBar="{Binding ShowStatusBar}"
                                NavIndent="{Binding NavIndent, Mode=TwoWay}"
                                IsSubShell="{Binding IsSubShell}"/>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Grid.Column="2" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <GroupBox Header="Staging">
            <StackPanel>
              <TextBlock Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="Default seed is Home (with nested pages), Workspace, Settings. Each radio owns its construction page."/>
              <Button Content="Stage PingIQ suite" Command="{Binding StageIqSuiteCommand}"/>
              <Button Content="Replace PingIQ with inner form" Command="{Binding ReplacePingWithInnerFormCommand}"/>
              <Button Content="Restore selected placeholder" Command="{Binding RestoreSelectedPlaceholderCommand}"/>
              <Button Content="Reset defaults" Command="{Binding ResetDefaultsCommand}"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Independence">
            <StackPanel>
              <CheckBox Content="Show status bar on the live form" IsChecked="{Binding ShowStatusBar}"/>
              <CheckBox Content="Treat live form as nested submenu" IsChecked="{Binding IsSubShell}"/>
              <TextBlock Margin="0,10,0,4" Text="{Binding NavIndent, StringFormat='Nav indent: {0} dip'}"/>
              <Slider Minimum="0" Maximum="80" TickFrequency="4" IsSnapToTickEnabled="True"
                      Value="{Binding NavIndent, Mode=TwoWay}"/>
              <WrapPanel Margin="0,8,0,0">
                <Border Background="#132744" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Text="{Binding SlotCount, StringFormat='{}{0} slots'}" Foreground="#D6E8FA"/>
                </Border>
                <Border Background="#132744" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Text="{Binding Scenario}" Foreground="#D6E8FA"/>
                </Border>
                <Border Background="#132744" Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Text="{Binding SelectedItem.Header, ElementName=LiveShell, FallbackValue='Home'}" Foreground="#D6E8FA"/>
                </Border>
              </WrapPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Status bar placement">
            <StackPanel>
              <RadioButton Content="Bottom (default)" IsChecked="{Binding IsDockedBottom}"/>
              <RadioButton Content="Top — under the radios, never over File / View" IsChecked="{Binding IsDockedTop}"/>
              <TextBlock Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="The chrome File / View row stays put. Only the shell's status rail moves."/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Contract">
            <StackPanel>
              <TextBlock Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"
                         Text="• VestigiumShell is nestable. VestigiumDefaultWindow is the startup wrapper.&#x0a;• Parent assigns theme. This assembly has no Theme DP.&#x0a;• Depth cap 3. Inner status bar off unless you turn it on.&#x0a;• NavIndent 0–80. Home ships nested Overview / Live / Shortcuts."/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" Grid.Column="0" BorderBrush="#1E3A5F" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#0F2744" Padding="8,4">
            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#D6E8FA"
                       Text="ALWAYS-NESTED EXAMPLE — IsSubShell, no status bar, no File / View"/>
          </Border>
          <shell:VestigiumShell x:Name="NestedSample"
                                IsSubShell="True"
                                ShowStatusBar="False"
                                ShellDepth="1"
                                NavIndent="{Binding NavIndent, Mode=OneWay}"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
