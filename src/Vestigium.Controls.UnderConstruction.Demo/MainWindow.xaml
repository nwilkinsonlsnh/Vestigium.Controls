<Window x:Class="Vestigium.Controls.UnderConstruction.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:Vestigium.Controls.UnderConstruction;assembly=Vestigium.Controls.UnderConstruction"
        Title="Vestigium.Controls.UnderConstruction — gallery"
        Height="860" Width="1100"
        MinHeight="560" MinWidth="800"
        Background="#0B1524" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#0F2744" Foreground="#E2E8F0" Padding="4,2">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
    </Menu>
    <TabControl Margin="16">
      <TabItem Header="Page">
        <uc:VestigiumUnderConstruction
            Title="Vestigium"
            Subject="Default form client area"
            Description="Feature views land here after their requirements are accepted."/>
      </TabItem>

      <TabItem Header="Overlay">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#94A3B8" TextWrapping="Wrap"
                     Text="2×2 module grid. Three cells are live. Reports is unfinished. Toggle IsActive and click the tile underneath."/>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="4" Background="#132744" BorderBrush="#1E3A5F" BorderThickness="1">
              <Button Content="Ping" Command="{Binding LiveTileCommand}"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Margin="4" Background="#132744" BorderBrush="#1E3A5F" BorderThickness="1">
              <Button Content="DNS" Command="{Binding LiveTileCommand}"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Margin="4" Background="#132744" BorderBrush="#1E3A5F" BorderThickness="1">
              <Button Content="Trace" Command="{Binding LiveTileCommand}"/>
            </Border>
            <Grid Grid.Row="1" Grid.Column="1" Margin="4">
              <Button Content="{Binding LiveClicks, StringFormat='Reports — clicks {0}'}"
                      Command="{Binding LiveTileCommand}"/>
              <uc:VestigiumUnderConstruction
                  Title="Reports"
                  Subject="Module in development"
                  Description="Scheduled for Q3."
                  IsActive="{Binding IsActive}"
                  Command="{Binding ActionCommand}"
                  ActionText="Notify me"/>
            </Grid>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Lab">
        <ScrollViewer>
          <StackPanel Margin="12">
            <uc:VestigiumUnderConstruction MinHeight="320"
                Title="{Binding Title}"
                TitleMaxLength="{Binding TitleMaxLength}"
                Subject="{Binding Subject}"
                SubjectMaxLength="{Binding SubjectMaxLength}"
                Description="{Binding Description}"
                IsActive="{Binding IsActive}"
                Command="{Binding ActionCommand}"
                ActionText="Notify me"
                IconData="{Binding IconData}"
                ImageSource="{Binding ImageSource}"
                ImageUri="{Binding ImageUri}"/>
            <TextBlock Margin="0,16,0,8" Text="Title (default max 75)"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,12,0,8" Text="Subject (default max 125)"/>
            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,12,0,8" Text="Description (unlimited unless you set a max)"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" MinHeight="64" AcceptsReturn="True"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Title max"/>
              <TextBox Width="72" Text="{Binding TitleMaxLength, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock VerticalAlignment="Center" Margin="16,0,8,0" Text="Subject max"/>
              <TextBox Width="72" Text="{Binding SubjectMaxLength, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <CheckBox Content="IsActive" IsChecked="{Binding IsActive}"/>
            <CheckBox Content="Attach Command (shows the button)" IsChecked="{Binding AttachCommand}"/>
            <TextBlock Margin="0,12,0,8" Text="Image — built-in, geometry, or a PNG/SVG file"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Built-in artwork" Command="{Binding UseBuiltInCommand}"/>
              <Button Content="Cone geometry" Command="{Binding UseConeCommand}"/>
              <Button Content="Barrier geometry" Command="{Binding UseBarrierCommand}"/>
              <Button Content="Browse PNG / SVG" Command="{Binding BrowseImageCommand}"/>
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Foreground="#94A3B8" Text="{Binding ActionLog}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
