<Application x:Class="Vestigium.Controls.UnderConstruction.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#0B1524"/>
    <SolidColorBrush x:Key="CardBg" Color="#132744"/>
    <SolidColorBrush x:Key="LayerBg" Color="#102038"/>
    <SolidColorBrush x:Key="Hairline" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Fg" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Accent" Color="#4A90C8"/>
    <SolidColorBrush x:Key="AccentFg" Color="#0B1524"/>
    <SolidColorBrush x:Key="Chrome" Color="#0F2744"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1A3A5C"/>
                <Setter Property="Foreground" Value="#F8FAFC"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#4A90C8"/>
                <Setter Property="Foreground" Value="#0B1524"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource LayerBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="tab"
                    Background="#102038"
                    BorderBrush="#1E3A5F"
                    BorderThickness="1,1,1,0"
                    Margin="0,0,4,0"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tab" Property="Background" Value="#1A3A5C"/>
                <Setter Property="Foreground" Value="#F8FAFC"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="tab" Property="Background" Value="#4A90C8"/>
                <Setter Property="Foreground" Value="#0B1524"/>
                <Setter TargetName="tab" Property="BorderBrush" Value="#4A90C8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource LayerBg}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Margin" Value="0,4,12,4"/>
    </Style>

    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
    </Style>
  </Application.Resources>
</Application>
